//doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1 Children
        .cards 
            if data && data.length
                each child in data
                    .card 
                        pre= JSON.stringify(child.properties, null, 2)
            else
                p No children found
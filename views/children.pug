//doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1 Children
        .cards 
            if data && data.length
                each child in data
                    .card 
                        h2.card__name #{child.properties.name}
                        p.card__dob Date of Birth: #{child.properties.date_of_birth}
                        p.card__ethnicity Ethnicity: #{child.properties.ethnicity}
                        p.card__blood_type Blood type: #{child.properties.blood_type}
            else
                p No children found